# Local Development Configuration (lighthouse-backend style env file)
# Used by: ./deploy.sh local <action>
# Safe defaults only — replace the placeholders to exercise the full loop.

# GitHub App (register one, or leave placeholders to test intake mechanics only)
GITHUB_APP_ID=000000
# base64 -w0 < your-app.private-key.pem   (macOS: base64 -i file)
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_WEBHOOK_SECRET=dev-webhook-secret

# Anthropic credential for role runs (one of the two)
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Where this service is reachable
PUBLIC_BASE_URL=http://localhost:8080
PORT=8080

# Factory source (FACTORY.md + role prompts)
FACTORY_REPO=genai-jerry/claude-software-factory
FACTORY_REF=v1

# Operations
DISPATCH_TOKEN=dev-dispatch-token
CLAIMED_REPOS=
FACTORY_CROSS_REPO_TOKEN=

# Factory Console secret store (optional — see README)
CONSOLE_DATABASE_URL=
CONSOLE_MASTER_KEY=
CONSOLE_ORG=
