# Production .env for the LangGraph orchestrator on the VPS
# ($HOME/factory-orchestrator/.env).
#
# GitHub Actions writes these keys on each deploy. Same Hostinger VPS and
# Traefik stack as Factory Console (~/factory-console). See orchestrator/README.md
# "Cloud deploy (Hostinger VPS)".

# ---------------------------------------------------------------------------
# GitHub Environment "production" on genai-jerry/claude-software-factory
# ---------------------------------------------------------------------------
# DEPLOY_HOST / DEPLOY_USER / DEPLOY_KEY   secrets   same SSH trio as Console
# PUBLIC_BASE_URL                          variable  https://factory.genaipeople.com
# FACTORY_GH_APP_ID                        secret    GitHub App numeric id
# FACTORY_GH_APP_PRIVATE_KEY_B64           secret    base64 -i app.pem  (no wraps)
# FACTORY_GH_WEBHOOK_SECRET                secret    (GitHub forbids GITHUB_*)
# DISPATCH_TOKEN                           secret    Bearer for /events and /dispatch
# ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN  secret  (or rely on Console /events)
# CLAIMED_REPOS                            variable  owner/repo,owner/repo
# FACTORY_REPO / FACTORY_REF               variable  defaults: this repo @ v1

# ---------------------------------------------------------------------------
# Written to ~/factory-orchestrator/.env
# ---------------------------------------------------------------------------

# REQUIRED. Public HTTPS origin Traefik serves. Run-log links in GitHub
# comments use this. DNS A record → the same VPS as the Console (187.127.165.119).
#   https://factory.genaipeople.com
PUBLIC_BASE_URL=

# Set by the workflow from PUBLIC_BASE_URL (hostname only). Traefik Host() rule.
# ORCHESTRATOR_HOST=factory.genaipeople.com

# REQUIRED. GitHub App the orchestrator uses to clone and comment when the
# Console did not send an installation token on /events.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_B64=
# GITHUB_WEBHOOK_SECRET=

# REQUIRED. Must match Factory Console's ORCHESTRATOR_DISPATCH_TOKEN.
# DISPATCH_TOKEN=

# OPTIONAL. Role-run credential. Console-forwarded tokens on /events win for
# that delivery; these fill what the Console did not send.
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

# OPTIONAL. Repos the reconciler sweeps (comma-separated owner/repo).
# CLAIMED_REPOS=genai-jerry/insurance-app-base

# OPTIONAL. Pin factory source (FACTORY.md + role prompts).
# FACTORY_REPO=genai-jerry/claude-software-factory
# FACTORY_REF=v1

# sqlite on the named volume is the default. Set a Postgres URL to outgrow it.
# DATABASE_URL=sqlite:////data/factory-orchestrator.db
