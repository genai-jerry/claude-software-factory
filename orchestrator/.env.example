# Copy to .env (compose reads it automatically; scripts/dev.sh sources it).
# Values here are safe local-dev defaults — replace the placeholders.

# --- GitHub App identity (register one at Settings -> Developer settings -> GitHub Apps)
GITHUB_APP_ID=000000
# Multi-line PEMs do not survive env files: paste the key base64-encoded
#   base64 -w0 < your-app.private-key.pem        (macOS: base64 -i file)
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_WEBHOOK_SECRET=dev-webhook-secret

# --- Anthropic credential for role runs (one of the two)
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# --- Storage: sqlite needs nothing; compose overrides this with Postgres
DATABASE_URL=sqlite:///factory-orchestrator.db

# --- Where this service is reachable (failure comments link <base>/runs/<id>)
PUBLIC_BASE_URL=http://localhost:8080

# --- Factory source (FACTORY.md + role prompts), pinned like the Actions stub
FACTORY_REPO=genai-jerry/claude-software-factory
FACTORY_REF=v1
# For local factory development, point at your working copy instead of cloning:
# FACTORY_LOCAL_PATH=/path/to/claude-software-factory

# --- Operations
DISPATCH_TOKEN=dev-dispatch-token
CLAIMED_REPOS=
FACTORY_CROSS_REPO_TOKEN=

# --- Optional LangSmith tracing (unset = off, no behaviour change)
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
