# Production Configuration (lighthouse-backend style env file)
# Used by: ./deploy.sh production <action> — e.g. running the compose stack
# directly on the server instead of (or before) the GitHub Actions deploy.
# Fill every placeholder; keep this file out of commits once it holds real
# values (edit on the host, like lighthouse's config.production.env).

GITHUB_APP_ID=REPLACE_ME
GITHUB_APP_PRIVATE_KEY_B64=REPLACE_ME
GITHUB_WEBHOOK_SECRET=REPLACE_ME

# One of the two (or leave both empty and set CONSOLE_* below)
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Public HTTPS address Traefik serves (run-log links). GitHub App webhooks
# still go to the Factory Console, not here, when using the software-factory engine.
PUBLIC_BASE_URL=https://factory.genaipeople.com
PORT=8080

FACTORY_REPO=genai-jerry/claude-software-factory
FACTORY_REF=v1

DISPATCH_TOKEN=REPLACE_ME
CLAIMED_REPOS=
FACTORY_CROSS_REPO_TOKEN=

# Factory Console secret store (optional): point at the Console's Postgres
# and reuse its master key to source agent secrets set through the Console UI
CONSOLE_DATABASE_URL=
CONSOLE_MASTER_KEY=
CONSOLE_ORG=

# Optional LangSmith tracing
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
