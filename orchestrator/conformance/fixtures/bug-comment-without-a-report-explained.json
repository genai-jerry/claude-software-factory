{
  "name": "bug-comment-without-a-report-explained",
  "description": "A bare Bug comment asks for the detail instead of filing an empty report",
  "config": {
    "testing": {
      "system_tests": true,
      "mode": "gate"
    },
    "approvers": {
      "spec": [
        "boss"
      ],
      "design": [
        "boss"
      ],
      "implementation": [
        "dev"
      ],
      "staging": [
        "boss"
      ],
      "testers": [
        "tess"
      ]
    },
    "branches": {
      "staging": "staging",
      "required": true,
      "auto_create": true,
      "epics": true
    }
  },
  "repo": {
    "issues": [
      {
        "number": 9,
        "title": "Add renewals",
        "labels": [
          "factory:design-approved"
        ]
      }
    ]
  },
  "event": {
    "name": "issue_comment",
    "action": "created",
    "issue": 9,
    "comment": {
      "body": "Bug",
      "login": "tess",
      "authorAssociation": "COLLABORATOR"
    }
  },
  "expect": {
    "role": "none",
    "createdCount": 0,
    "comments": {
      "9": {
        "countAtLeast": 1,
        "contains": [
          "needs the report underneath it",
          "<!-- factory-agent -->"
        ]
      }
    }
  }
}
