{
  "name": "simulate-tests-starts-the-test-planner",
  "description": "a staging approver comments Simulate tests on a planned epic in a repo with a simulate block: the Test Planner runs",
  "config": {
    "testing": {
      "system_tests": true,
      "mode": "gate",
      "run_on": "staging",
      "simulate": {
        "pack": "beacon/sim/scenarios",
        "status_context": "beacon/sim-scenarios",
        "run_repo": "o/infra"
      }
    },
    "approvers": {
      "spec": [
        "boss"
      ],
      "design": [
        "boss"
      ],
      "implementation": [
        "dev"
      ],
      "staging": [
        "boss"
      ],
      "testers": [
        "tess"
      ]
    },
    "branches": {
      "staging": "staging",
      "required": true,
      "auto_create": true,
      "epics": true
    }
  },
  "repo": {
    "issues": [
      {
        "number": 9,
        "title": "Add renewals",
        "labels": [
          "factory:epic-ready"
        ]
      }
    ]
  },
  "event": {
    "name": "issue_comment",
    "action": "created",
    "issue": 9,
    "comment": {
      "body": "Simulate tests",
      "login": "boss",
      "authorAssociation": "OWNER"
    }
  },
  "expect": {
    "role": "testplanner",
    "issues": [
      "9"
    ]
  }
}
