{
  "name": "test-passed-closes-the-case",
  "description": "a testers approver comments Test Passed on a runnable case: it passes, closes, and the epic is re-dispatched",
  "config": {
    "testing": {
      "system_tests": true,
      "mode": "gate"
    },
    "approvers": {
      "spec": [
        "boss"
      ],
      "design": [
        "boss"
      ],
      "implementation": [
        "dev"
      ],
      "staging": [
        "boss"
      ],
      "testers": [
        "tess"
      ]
    }
  },
  "repo": {
    "issues": [
      {
        "number": 9,
        "title": "Add renewals",
        "labels": [
          "factory:design-approved"
        ]
      },
      {
        "number": 30,
        "title": "test(9): ST-4 Renewal reminder fires",
        "labels": [
          "factory:manual-test"
        ]
      }
    ]
  },
  "event": {
    "name": "issue_comment",
    "action": "created",
    "issue": 30,
    "comment": {
      "body": "Test Passed",
      "login": "tess",
      "authorAssociation": "COLLABORATOR"
    }
  },
  "expect": {
    "role": "dispatch",
    "issues": [
      "9"
    ],
    "labels": {
      "30": {
        "has": [
          "factory:test-passed"
        ],
        "not": [
          "factory:manual-test"
        ]
      }
    },
    "comments": {
      "30": {
        "countAtLeast": 1,
        "contains": [
          "ST-4 passed",
          "@tess"
        ]
      }
    }
  }
}
