{
  "name": "bug-on-a-case-raises-against-the-epic",
  "description": "Bug on a test case raises the report on its epic and leaves the case alone",
  "config": {
    "testing": {
      "system_tests": true,
      "mode": "gate"
    },
    "approvers": {
      "spec": [
        "boss"
      ],
      "design": [
        "boss"
      ],
      "implementation": [
        "dev"
      ],
      "staging": [
        "boss"
      ],
      "testers": [
        "tess"
      ]
    },
    "branches": {
      "staging": "staging",
      "required": true,
      "auto_create": true,
      "epics": true
    }
  },
  "repo": {
    "issues": [
      {
        "number": 9,
        "title": "Add renewals",
        "labels": [
          "factory:design-approved"
        ]
      },
      {
        "number": 30,
        "title": "test(9): ST-4 Renewal reminder fires",
        "labels": [
          "factory:manual-test"
        ],
        "body": "Part of #9"
      }
    ]
  },
  "event": {
    "name": "issue_comment",
    "action": "created",
    "issue": 30,
    "comment": {
      "body": "Bug: the discount is ignored on the checkout total\nSteps: add SAVE10 to a cart of 100.00\nSaw: total 100.00 — expected 90.00",
      "login": "tess",
      "authorAssociation": "COLLABORATOR"
    }
  },
  "expect": {
    "role": "none",
    "labels": {
      "30": {
        "has": [
          "factory:manual-test"
        ],
        "not": [
          "factory:test-failed",
          "factory:bug-open"
        ]
      }
    },
    "createdIssues": [
      {
        "titlePattern": "^bug\\(9\\):",
        "labels": [
          "factory:bug",
          "factory:bug-open"
        ],
        "bodyContains": [
          "Seen on: #30"
        ]
      }
    ],
    "createdCount": 2,
    "comments": {
      "30": {
        "countAtLeast": 1,
        "contains": [
          "Raised as bug #",
          "a bug is its own report"
        ]
      }
    }
  }
}
