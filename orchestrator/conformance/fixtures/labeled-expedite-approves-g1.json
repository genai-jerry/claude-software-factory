{
  "name": "labeled-expedite-approves-g1",
  "description": "expedite on an epic at spec-ready approves gate G1 itself and starts the planner",
  "config": {
    "approvers": {
      "release_scope": [
        "boss"
      ],
      "spec": [
        "boss"
      ],
      "design": [
        "boss"
      ],
      "implementation": [
        "boss"
      ],
      "expedite": [
        "boss"
      ],
      "staging": [
        "boss"
      ]
    }
  },
  "repo": {
    "issues": [
      {
        "number": 5,
        "title": "Epic",
        "labels": [
          "factory:spec-ready",
          "factory:expedite"
        ]
      }
    ]
  },
  "event": {
    "name": "issues",
    "action": "labeled",
    "issue": 5,
    "label": "factory:expedite",
    "sender": "boss"
  },
  "expect": {
    "role": "planner",
    "issues": [
      "5"
    ],
    "labels": {
      "5": {
        "has": [
          "factory:spec-approved",
          "factory:expedite"
        ],
        "not": [
          "factory:spec-ready"
        ]
      }
    }
  }
}
