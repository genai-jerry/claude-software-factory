{
  "name": "labeled-expedite-starts-qa",
  "description": "expedite on a task at factory:in-test starts its qa with no human approval",
  "config": {
    "approvers": {
      "release_scope": [
        "boss"
      ],
      "spec": [
        "boss"
      ],
      "design": [
        "boss"
      ],
      "implementation": [
        "boss"
      ],
      "expedite": [
        "boss"
      ],
      "staging": [
        "boss"
      ]
    }
  },
  "repo": {
    "issues": [
      {
        "number": 5,
        "title": "task(9) do the thing",
        "labels": [
          "factory:in-test",
          "factory:expedite"
        ]
      }
    ]
  },
  "event": {
    "name": "issues",
    "action": "labeled",
    "issue": 5,
    "label": "factory:expedite",
    "sender": "boss"
  },
  "expect": {
    "role": "qa",
    "issues": [
      "5"
    ],
    "labels": {
      "5": {
        "has": [
          "factory:in-test"
        ]
      }
    }
  }
