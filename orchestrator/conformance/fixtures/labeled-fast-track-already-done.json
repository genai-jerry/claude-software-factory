{
  "name": "labeled-fast-track-already-done",
  "description": "re-applying factory:fast-track after the fast lane opened a PR does not run it again",
  "config": {
    "approvers": {
      "release_scope": [
        "boss"
      ],
      "spec": [
        "boss"
      ],
      "design": [
        "boss"
      ],
      "implementation": [
        "boss"
      ]
    },
    "release": {
      "gating": "milestone",
      "approval": "human",
      "auto_create_release_issue": true,
      "exempt_labels": [
        "factory:fast-track"
      ]
    }
  },
  "repo": {
    "issues": [
      {
        "number": 5,
        "title": "Rename a page title",
