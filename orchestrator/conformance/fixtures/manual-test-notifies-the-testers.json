{
  "name": "manual-test-notifies-the-testers",
  "description": "a case reaching factory:manual-test assigns and @-mentions the testers",
  "config": {
    "testing": {
      "system_tests": true,
      "mode": "gate"
    },
    "approvers": {
      "spec": [
        "boss"
      ],
      "design": [
        "boss"
      ],
      "implementation": [
        "dev"
      ],
      "staging": [
        "boss"
      ],
      "testers": [
        "tess"
      ]
    }
  },
  "repo": {
    "issues": [
      {
        "number": 30,
        "title": "test(9): ST-4 Renewal reminder fires",
        "labels": [
          "factory:manual-test"
        ]
      }
    ]
  },
  "event": {
    "name": "issues",
    "action": "labeled",
    "issue": 30,
    "label": "factory:manual-test",
    "sender": "factory-app"
  },
  "expect": {
    "role": "none",
    "comments": {
      "30": {
        "countAtLeast": 1,
        "contains": [
          "@tess",
          "Test Passed",
          "Test Failed"
        ]
      }
    }
  }
}
