{
  "name": "plan-release-no-milestone",
  "description": "Plan release on an issue with no milestone is answered without inventing a tracker",
  "config": {
    "approvers": {
      "release_scope": [
        "boss"
      ],
      "spec": [
        "boss"
      ],
      "design": [
        "boss"
      ],
      "implementation": [
        "boss"
      ]
    },
    "release": {
      "gating": "milestone",
      "approval": "human",
      "auto_create_release_issue": true,
      "exempt_labels": [
        "factory:fast-track"
      ]
    }
  },
  "repo": {
    "issues": [
      {
        "number": 5,
        "title": "Add renewals",
        "labels": [
          "factory:backlog"
        ]
      }
    ]
  },
  "event": {
    "name": "issue_comment",
    "action": "created",
    "issue": 5,
    "comment": {
      "body": "Plan release",
      "login": "boss",
      "authorAssociation": "OWNER"
    }
  },
  "expect": {
    "role": "none",
    "createdCount": 0,
    "comments": {
      "5": {
        "count": 1,
        "contains": [
          "no release to plan"
        ]
      }
    }
  }
}
