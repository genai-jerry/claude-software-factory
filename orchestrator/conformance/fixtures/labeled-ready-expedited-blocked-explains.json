{
  "name": "labeled-ready-expedited-blocked-explains",
  "description": "an expedited task that reaches factory:ready while blocked starts nothing and says so, rather than asking approvers for a click expedite already waived",
  "config": {
    "approvers": {
      "implementation": [
        "boss"
      ],
      "expedite": [
        "boss"
      ]
    }
  },
  "repo": {
    "issues": [
      {
        "number": 5,
        "title": "Epic",
        "labels": [
          "factory:design-approved",
          "factory:expedite"
        ]
      },
      {
        "number": 8,
        "title": "task(5) do the thing",
        "body": "Part of o/r#5",
        "labels": [
          "factory:ready",
          "factory:blocked"
        ]
      }
    ]
  },
  "event": {
    "name": "issues",
    "action": "labeled",
    "issue": 8,
    "label": "factory:ready",
    "sender": "boss"
  },
  "expect": {
    "role": "none",
    "comments": {
      "8": {
        "count": 1,
        "contains": [
          "factory:blocked"
        ],
        "notContains": [
          "is waiting on you"
        ]
      }
    }
  }
}
