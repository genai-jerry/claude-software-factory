{
  "name": "labeled-ready-unexpedited-still-notifies",
  "description": "the same label on a task whose epic is not expedited still asks its approvers",
  "config": {
    "approvers": {
      "implementation": [
        "boss"
      ],
      "expedite": [
        "boss"
      ]
    }
  },
  "repo": {
    "issues": [
      {
        "number": 5,
        "title": "Epic",
        "labels": [
          "factory:design-approved"
        ]
      },
      {
        "number": 8,
        "title": "task(5) do the thing",
        "body": "Part of o/r#5",
        "labels": [
          "factory:ready"
        ]
      }
    ]
  },
  "event": {
    "name": "issues",
    "action": "labeled",
    "issue": 8,
    "label": "factory:ready",
    "sender": "boss"
  },
  "expect": {
    "role": "none",
    "comments": {
      "8": {
        "countAtLeast": 1,
        "contains": [
          "@boss",
          "Implementation start"
        ]
      }
    }
  }
}
